// MARK: - Nesting Atlas Code
"NestingAtlasCode.title.1" = "0. Vrsta opažena, ali se sumnja da je u migraciji ili da ljetuje kao negnijezdeća.";
"NestingAtlasCode.title.2" = "1. Vrsta opažena u sezoni gniježđenja u mogućem staništu za gniježđenje.";
"NestingAtlasCode.title.3" = "2. Pjevajući mužjak (ili se čuju pozivi za parenje) prisutan u sezoni gniježđenja.";
"NestingAtlasCode.title.4" = "3. Par opažen u pogodnom staništu za gniježđenje tokom sezone gniježđenja.";
"NestingAtlasCode.title.5" = "4. Stalni teritorij pretpostavljen na osnovu opažanja teritorijalnog ponašanja (pjesma, itd.) u najmanje dva različita dana s razmakom od sedmicu dana na istom mjestu.";
"NestingAtlasCode.title.6" = "5. Udvaranje i rituali parenja";
"NestingAtlasCode.title.7" = "6. Posjećivanje vjerovatnog mjesta gniježđenja";
"NestingAtlasCode.title.8" = "7. Uznemireno ponašanje ili znakovi tjeskobe kod odraslih ptica";
"NestingAtlasCode.title.9" = "8. Gola trbušna ploha (brood patch) opažena na odrasloj ptici u ruci";
"NestingAtlasCode.title.10" = "9. Izgradnja gnijezda ili kopanje rupe za gnijezdo";
"NestingAtlasCode.title.11" = "10. Ponašanje odvraćanja pažnje ili simuliranje ozljede";
"NestingAtlasCode.title.12" = "11. Pronađeno korišteno gnijezdo ili ljuske jaja (zauzeto ili položeno u periodu istraživanja)";
"NestingAtlasCode.title.13" = "12. Nedavno opernati mladi (nidikolne vrste) ili paperjasti mladi (nidifugne vrste)";
"NestingAtlasCode.title.14" = "13. Odrasli ulaze ili izlaze iz mjesta gniježđenja u okolnostima koje ukazuju na zauzeto gnijezdo (uključujući visoka gnijezda ili duplje čiji sadržaj nije vidljiv) ili odrasla ptica viđena u inkubaciji";
"NestingAtlasCode.title.15" = "14. Odrasla ptica nosi izmetnu vrećicu ili hranu za mlade";
"NestingAtlasCode.title.16" = "15. Gnijezdo s jajima";
"NestingAtlasCode.title.17" = "16. Gnijezdo s mladima viđeno ili čujno";


"NestingAtlasCode.title.9" = "8. Gola trbušna ploha (brood patch) opažena na odrasloj ptici u ruci";
"NestingAtlasCode.title.10" = "9. Izgradnja gnijezda ili kopanje rupe za gnijezdo";
"NestingAtlasCode.title.11" = "10. Ponašanje odvraćanja pažnje ili simuliranje ozljede";
"NestingAtlasCode.title.12" = "11. Pronađeno korišteno gnijezdo ili ljuske jaja (zauzeto ili položeno u razdoblju istraživanja)";
"NestingAtlasCode.title.13" = "12. Nedavno opernati mladi (nidikolne vrste) ili paperjasti mladi (nidifugne vrste)";
"NestingAtlasCode.title.14" = "13. Odrasli ulaze ili izlaze iz mjesta gniježđenja u okolnostima koje ukazuju na zauzeto gnijezdo (uključujući visoka gnijezda ili duplje čiji sadržaj nije vidljiv) ili odrasla ptica viđena u inkubaciji";
"NestingAtlasCode.title.15" = "14. Odrasla ptica nosi izmetnu vrećicu ili hranu za mlade";
"NestingAtlasCode.title.16" = "15. Gnijezdo s jajima";

// MARK: - Nesting Altas Code
"NestingAtlasCode.title.1" = "0. Сумња се да је јединка на сеоби или да се само задржава током летњег периода, али се не гнезди";
"NestingAtlasCode.title.2" = "1. Врста посматрана у гнездећој сезони у могућем гнездећем станишту";
"NestingAtlasCode.title.3" = "2. Територијални (певајући) мужјак присутан током гнездеће сезоне";
"NestingAtlasCode.title.4" = "3. Пар посматран у станишту погодном за гнежђење, током гнездеће сезоне";
"NestingAtlasCode.title.5" = "4. Територијално понашање (песма, свадбени лет, итд.) забележено током најмање два различита дана у седмици или у већем временском размаку, увек на истом месту";
"NestingAtlasCode.title.6" = "5. Удварање, шепурење или свадбени лет";
"NestingAtlasCode.title.7" = "6. Посећивање могуће гнездеће територије";
"NestingAtlasCode.title.8" = "7. Узнемирено понашање или нервозно оглашавање одраслих птица";
"NestingAtlasCode.title.9" = "8. Гнездећа пега на одраслој јединки прегледаној из руке";
"NestingAtlasCode.title.10" = "9. Изградња гнезда или дубљење гнездеће дупље";
"NestingAtlasCode.title.11" = "10. Одвраћање пажње или глумљење повреде";
"NestingAtlasCode.title.12" = "11. Пронађено коришћено гнездо/љуске од јаја (заузето/положено током периода истраживања)";
"NestingAtlasCode.title.13" = "12. Недавно излежени младунци (чучавци) или младунци у паперју (потркушци)";
"NestingAtlasCode.title.14" = "13. Родитељи који посећују гнездо у околностима које указују на заузетост гнезда или родитељи посматрани на гнезду током инкубације";
"NestingAtlasCode.title.15" = "14. Родитељи износе измет младунаца из гнезда или носе храну за младунце";
"NestingAtlasCode.title.16" = "15. Пронађено гнездо са јајима";
"NestingAtlasCode.title.17" = "16. Пронађено гнездо са младунцима (посматраним или слушаним)";

